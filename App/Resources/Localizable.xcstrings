    "Use your coding agent as usual. It asks you before each step, or it works on its own when you choose that.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie Ihren Coding-Agent wie gewohnt. Er fragt Sie vor jedem Schritt oder arbeitet selbstständig, wenn Sie das wählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your coding agent as usual. It asks you before each step, or it works on its own when you choose that."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa tu agente de programación como siempre. Te pregunta antes de cada paso, o trabaja por su cuenta si así lo eliges."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez votre agent de code comme d’habitude. Il vous demande avant chaque étape, ou il travaille seul si vous le choisissez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa il tuo agente di programmazione come sempre. Ti chiede prima di ogni passaggio, oppure lavora da solo quando lo scegli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつものようにコーディングエージェントを使ってください。各ステップの前に確認するか、選択すれば自分で作業します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코딩 에이전트를 평소처럼 사용하세요. 각 단계 전에 묻거나, 선택에 따라 스스로 작업합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o seu agente de programação como de costume. Ele pergunta antes de cada etapa ou trabalha por conta própria quando você escolher isso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пользуйтесь агентом для программирования как обычно. Он спрашивает вас перед каждым шагом или работает сам, если вы это выберете."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "像平常一样使用你的编程智能体。它在每一步之前先问你；你也可以选择让它自行工作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "像平常一樣使用你的程式設計智慧代理。它在每一步之前先問你；你也可以選擇讓它自行工作。"
          }
        }
      }
    },

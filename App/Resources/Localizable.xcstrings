          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет строку «Терминал» под каждым листом с той же командой, для поддержки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",

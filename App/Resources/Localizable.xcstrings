    "Clear the saved state of %@? The next start is cold, about 30 s. Your data in the app stays.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesicherten Zustand von %@ löschen? Der nächste Start ist kalt, etwa 30 Sek. Ihre Daten in der App bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear the saved state of %@? The next start is cold, about 30 s. Your data in the app stays."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Borrar el estado guardado de %@? El próximo inicio será en frío, de unos 30 s. Tus datos en la app se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacer l’état enregistré de %@ ? Le prochain démarrage sera à froid, environ 30 s. Vos données dans l’app sont conservées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancellare lo stato salvato di %@? Il prossimo avvio sarà a freddo, circa 30 s. I tuoi dati nell'app restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の保存状態を消去しますか?次回の起動はコールドスタートで、約30秒かかります。アプリ内のデータは残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 저장된 상태를 지울까요? 다음 시작은 콜드 스타트로 약 30초 걸립니다. 앱의 데이터는 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpar o estado salvo de %@? O próximo início é a frio, cerca de 30 s. Seus dados no app permanecem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить сохранённое состояние %@? Следующий запуск будет холодным, около 30 с. Данные в приложении сохранятся."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要清除 %@ 的已存状态吗？下次启动为冷启动，约 30 秒。应用里的数据会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要清除 %@ 的已儲存狀態嗎？下次啟動為冷啟動，約需 30 秒。應用程式裡的資料會保留。"
          }
        }
      }
    },

            "state": "translated",
            "value": "Aún no hay nada guardado. El primer inicio prepara la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est encore stocké. Le premier démarrage prépare l’app."
          }
        },

    "Update paddock for Mac: paddock %@ is newer than it knows.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisieren Sie paddock for Mac: paddock %@ ist neuer, als es kennt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update paddock for Mac: paddock %@ is newer than it knows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza paddock for Mac: paddock %@ es más reciente de lo que conoce."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez à jour paddock for Mac : paddock %@ est plus récent que ce qu’il connaît."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiorna paddock for Mac: paddock %@ è più recente di quanto conosca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "paddock for Macをアップデートしてください。paddock %@は、認識できるバージョンより新しいものです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "paddock for Mac을 업데이트하세요. paddock %@이(가) 알고 있는 버전보다 최신입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualize o paddock for Mac: o paddock %@ é mais novo do que ele conhece."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновите paddock for Mac: paddock %@ новее, чем он знает."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请更新 paddock for Mac：paddock %@ 比它认识的版本新。"

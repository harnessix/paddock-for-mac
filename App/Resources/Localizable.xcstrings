    "Stop building the base image? The downloaded part stays, so you can continue later.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufbau des Basis-Images stoppen? Der geladene Teil bleibt erhalten, sodass Sie später fortfahren können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop building the base image? The downloaded part stays, so you can continue later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Detener la creación de la imagen base? La parte descargada se conserva, así que puedes continuar más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter la création de l’image de base ? La partie téléchargée est conservée, vous pourrez continuer plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompere la creazione dell'immagine di base? La parte scaricata resta, così puoi continuare più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベースイメージの作成を停止しますか?ダウンロード済みの部分は残るので、後で続けられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 이미지 빌드를 중지할까요? 다운로드한 부분은 유지되므로 나중에 이어서 할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parar a criação da imagem-base? A parte baixada permanece, então você pode continuar depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остановить сборку базового образа? Загруженная часть сохранится, и вы сможете продолжить позже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要停止构建基础映像吗？已下载的部分会保留，之后可以继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要停止建置基礎映像檔嗎？已下載的部分會保留，之後可以繼續。"
          }
        }
      }
    },

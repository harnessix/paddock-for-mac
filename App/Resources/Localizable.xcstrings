    "Some lines changed on both sides: paddock marks them in the file.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Zeilen wurden auf beiden Seiten geändert: paddock markiert sie in der Datei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some lines changed on both sides: paddock marks them in the file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas líneas cambiaron en ambos lados: paddock las marca en el archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines lignes ont changé des deux côtés : paddock les marque dans le fichier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcune righe sono cambiate su entrambi i lati: paddock le segna nel file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両側で変更された行があります。paddockはファイル内でそれらに印を付けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "양쪽에서 변경된 줄이 있습니다. paddock이 파일에 표시해 둡니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas linhas mudaram dos dois lados: o paddock as marca no arquivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые строки изменены с обеих сторон: paddock отмечает их в файле."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有些行两边都改过：paddock 会在文件中标出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有些行兩邊都改過：paddock 會在檔案中標出。"
          }
        }
      }
    },

          }
        }
      }
    },
    "Nothing to clean up. paddock keeps only what your apps need.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts aufzuräumen. paddock behält nur, was Ihre Apps brauchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to clean up. paddock keeps only what your apps need."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada que limpiar. paddock solo conserva lo que tus apps necesitan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à nettoyer. paddock ne garde que ce dont vos apps ont besoin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente da pulire. paddock conserva solo ciò che serve alle tue app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリーンアップするものはありません。paddockはアプリに必要なものだけを保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정리할 항목이 없습니다. paddock은 앱에 필요한 것만 보관합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada para limpar. O paddock mantém apenas o que seus apps precisam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очищать нечего. paddock хранит только то, что нужно вашим приложениям."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可清理的内容。paddock 只保留应用需要的文件。"

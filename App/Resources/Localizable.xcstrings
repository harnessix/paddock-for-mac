    "paddock backs up each file it replaces or deletes. ⌘Z takes the apply back.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "paddock sichert jede Datei, die es ersetzt oder löscht. Mit ⌘Z machen Sie das Anwenden rückgängig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "paddock backs up each file it replaces or deletes. ⌘Z takes the apply back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "paddock hace una copia de seguridad de cada archivo que reemplaza o elimina. ⌘Z deshace la aplicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "paddock sauvegarde chaque fichier qu’il remplace ou supprime. ⌘Z annule l’application."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "paddock fa il backup di ogni file che sostituisce o elimina. ⌘Z annulla l'applicazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "paddockは、置き換えたり削除したりする各ファイルをバックアップします。⌘Zで適用を取り消せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "paddock은 교체하거나 삭제하는 각 파일을 백업합니다. ⌘Z로 적용을 되돌릴 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O paddock faz backup de cada arquivo que substitui ou exclui. ⌘Z desfaz a aplicação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "paddock делает резервную копию каждого файла, который заменяет или удаляет. ⌘Z отменяет применение."
          }
        },
        "zh-Hans": {
          "stringUnit": {

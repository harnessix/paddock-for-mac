          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지원을 위해 각 시트 아래에 같은 명령이 있는 터미널 행을 추가합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",

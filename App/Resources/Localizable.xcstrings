    "Add an app from your Applications folder. It runs in its own sandbox the next time you start it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie eine App aus Ihrem Programme-Ordner hinzu. Sie läuft beim nächsten Start in einer eigenen Sandbox."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add an app from your Applications folder. It runs in its own sandbox the next time you start it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una app de tu carpeta Aplicaciones. Se ejecuta en su propio entorno aislado la próxima vez que la inicies."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une app depuis votre dossier Applications. Elle s’exécute dans son propre bac à sable au prochain démarrage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un'app dalla cartella Applicazioni. Al prossimo avvio verrà eseguita nella sua sandbox."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「アプリケーション」フォルダからアプリを追加します。次回起動すると、アプリは専用のサンドボックスで実行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응용 프로그램 폴더에서 앱을 추가하세요. 다음에 시작할 때 자체 샌드박스에서 실행됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um app da sua pasta Aplicativos. Ele roda no próprio sandbox na próxima vez que você o iniciar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте приложение из папки «Программы». При следующем запуске оно будет работать в собственной песочнице."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“应用程序”文件夹添加应用。下次启动时，它会在自己的沙盒中运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從「應用程式」資料夾加入應用程式。下次啟動時，它會在自己的沙箱中執行。"
          }
        }
      }

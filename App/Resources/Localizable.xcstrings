    "Each agent lives in its own room. It cannot reach your keys or your other projects.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Agent lebt in einem eigenen Raum. Er kann weder Ihre Schlüssel noch Ihre anderen Projekte erreichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each agent lives in its own room. It cannot reach your keys or your other projects."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada agente vive en su propia sala. No puede acceder a tus claves ni a tus otros proyectos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque agent vit dans sa propre salle. Il ne peut pas accéder à vos clés ni à vos autres projets."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni agente vive nella sua stanza. Non può raggiungere le tue chiavi né i tuoi altri progetti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各エージェントは専用のルームで動きます。あなたのキーや他のプロジェクトにはアクセスできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 에이전트는 자체 룸에서 작동합니다. 에이전트는 사용자의 키나 다른 프로젝트에 접근할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada agente vive na própria sala. Ele não alcança suas chaves nem seus outros projetos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый агент живёт в своей комнате. Он не может добраться до ваших ключей и других проектов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个智能体都住在自己的房间里，碰不到你的密钥和其他项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個智慧代理都住在自己的房間裡，碰不到你的金鑰和其他專案。"
          }
        }
      }
    },
    "Each instance is its own sandbox with its own login, files and rules.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Instanz ist eine eigene Sandbox mit eigener Anmeldung, eigenen Dateien und Regeln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each instance is its own sandbox with its own login, files and rules."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada instancia es su propio entorno aislado, con su propio inicio de sesión, archivos y reglas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque instance est son propre bac à sable, avec sa propre connexion, ses fichiers et ses règles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni istanza è una sandbox a sé, con il proprio accesso, i propri file e le proprie regole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各インスタンスは、専用のログイン、ファイル、ルールを持つ独立したサンドボックスです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 인스턴스는 자체 로그인, 파일, 규칙을 가진 별도의 샌드박스입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada instância é um sandbox próprio, com login, arquivos e regras próprios."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый экземпляр — отдельная песочница со своей учётной записью, файлами и правилами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个实例都是独立的沙盒，有自己的登录、文件和规则。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個實例都是獨立的沙箱，有自己的登入資訊、檔案和規則。"
          }
        }
      }
    },

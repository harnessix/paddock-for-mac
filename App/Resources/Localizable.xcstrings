    "%@ asked %lld times in a minute. paddock paused the questions.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ hat %lld Mal in einer Minute gefragt. paddock hat die Fragen angehalten."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ hat %lld Mal in einer Minute gefragt. paddock hat die Fragen angehalten."
                }
              }
            }
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ asked %lld times in a minute. paddock paused the questions."
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ preguntó %lld vez en un minuto. paddock pausó las preguntas."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ preguntó %lld veces en un minuto. paddock pausó las preguntas."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ a demandé %lld fois en une minute. paddock a mis les questions en pause."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ a demandé %lld fois en une minute. paddock a mis les questions en pause."
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ ha chiesto %lld volta in un minuto. paddock ha messo in pausa le domande."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ ha chiesto %lld volte in un minuto. paddock ha messo in pausa le domande."
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@が1分間に%2$lld回確認しました。paddockは確認を一時停止しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 1분 동안 %lld번 요청했습니다. paddock이 질문을 일시 중지했습니다."
          }
        },
        "pt-BR": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ perguntou %lld vez em um minuto. O paddock pausou as perguntas."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ perguntou %lld vezes em um minuto. O paddock pausou as perguntas."
                }
              }
            }
          }
        },
        "ru": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {

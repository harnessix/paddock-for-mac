    "The build stopped before the base image was ready. Try Again continues where it stopped.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Aufbau wurde gestoppt, bevor das Basis-Image bereit war. „Erneut versuchen“ macht dort weiter, wo er gestoppt hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The build stopped before the base image was ready. Try Again continues where it stopped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La creación se detuvo antes de que la imagen base estuviera lista. Reintentar continúa donde se detuvo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La création s’est arrêtée avant que l’image de base soit prête. Réessayer continue là où elle s’est arrêtée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La creazione si è fermata prima che l'immagine di base fosse pronta. Riprova continua da dove si era fermata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベースイメージの準備ができる前に作成が停止しました。「再試行」をクリックすると、止まったところから続きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 이미지가 준비되기 전에 빌드가 중지되었습니다. ‘다시 시도’를 클릭하면 멈춘 지점부터 이어집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A criação parou antes de a imagem-base ficar pronta. Tentar de novo continua de onde parou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сборка остановилась до готовности базового образа. «Повторить» продолжит с того места, где она остановилась."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "构建在基础映像就绪前停止了。“重试”会从停止的地方继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建置在基礎映像檔就緒前停止了。「重試」會從停止的地方繼續。"
          }
        }
      }
    },
    "The build stopped before the base image was sealed. Try Again continues where it stopped.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",

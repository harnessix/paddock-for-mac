    "%@ was updated on this Mac. The next start copies the new version, about 1 min.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde auf diesem Mac aktualisiert. Beim nächsten Start wird die neue Version kopiert, etwa 1 Min."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ was updated on this Mac. The next start copies the new version, about 1 min."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se actualizó en este Mac. El próximo inicio copia la versión nueva, unos 1 min."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a été mis à jour sur ce Mac. Le prochain démarrage copie la nouvelle version, environ 1 min."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è stata aggiornata su questo Mac. Al prossimo avvio viene copiata la nuova versione, circa 1 min."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@がこのMacで更新されました。次回の起動時に新しいバージョンをコピーします(約1分)。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 %@이(가) 업데이트되었습니다. 다음 시작 때 새 버전을 복사하며, 약 1분 걸립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ foi atualizado neste Mac. O próximo início copia a nova versão, cerca de 1 min."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ обновлено на этом Mac. При следующем запуске будет скопирована новая версия, около 1 мин."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已在这台 Mac 上更新。下次启动时会拷贝新版本，约 1 分钟。"

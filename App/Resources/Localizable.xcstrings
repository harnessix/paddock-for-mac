            "state": "translated",
            "value": "Añade una fila de Terminal bajo cada hoja con el mismo comando, para soporte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute une ligne Terminal sous chaque feuille avec la même commande, pour l’assistance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge una riga Terminale sotto ogni riquadro con lo stesso comando, per l'assistenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",

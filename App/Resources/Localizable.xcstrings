    "Adds a Terminal row under each sheet with the same command, for support.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt unter jedem Blatt eine Terminal-Zeile mit demselben Befehl hinzu, für den Support."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds a Terminal row under each sheet with the same command, for support."
          }
        },
        "es": {

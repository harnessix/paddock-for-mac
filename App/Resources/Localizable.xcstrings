    "Storage needs paddock. Install or update it, then click Check Again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Speicher benötigt paddock. Installieren oder aktualisieren Sie es und klicken Sie dann auf „Erneut prüfen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Storage needs paddock. Install or update it, then click Check Again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Almacenamiento necesita paddock. Instálalo o actualízalo y haz clic en Comprobar de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stockage nécessite paddock. Installez-le ou mettez-le à jour, puis cliquez sur Vérifier à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'archiviazione richiede paddock. Installalo o aggiornalo, poi clicca su Controlla di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストレージにはpaddockが必要です。インストールまたはアップデートしてから、「もう一度確認」をクリックしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 공간에는 paddock이 필요합니다. 설치하거나 업데이트한 다음 ‘다시 확인’을 클릭하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O armazenamento precisa do paddock. Instale-o ou atualize-o e clique em Verificar de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",

    "%@ comes from the App Store and needs an Apple ID, which the guest does not have. Install the download from the maker's website into /Applications instead.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ stammt aus dem App Store und benötigt eine Apple ID, die der Gast nicht hat. Installieren Sie stattdessen den Download von der Website des Herstellers in /Applications."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ comes from the App Store and needs an Apple ID, which the guest does not have. Install the download from the maker's website into /Applications instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ viene de la App Store y necesita un Apple ID, que el invitado no tiene. Instala en /Applications la descarga del sitio web del desarrollador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ provient de l’App Store et nécessite un identifiant Apple, que l’invité n’a pas. Installez plutôt le téléchargement du site de l’éditeur dans /Applications."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ proviene dall'App Store e richiede un Apple ID, che l'ospite non ha. Installa invece in /Applications il download dal sito web del produttore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はApp Storeから入手するアプリで、ゲストにはないApple IDが必要です。代わりに、開発元のWebサイトからダウンロードしたものを/Applicationsにインストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) App Store에서 제공되며 게스트에 없는 Apple ID가 필요합니다. 대신 제작사 웹사이트에서 받은 설치 파일로 /Applications에 설치하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vem da App Store e precisa de um Apple ID, que o convidado não tem. Instale em /Applications o download do site do fabricante."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ распространяется через App Store и требует Apple ID, которого нет в гостевой системе. Вместо этого установите загрузку с сайта разработчика в /Applications."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 来自 App Store，需要 Apple ID，而沙盒里没有。请改为从开发者网站下载，并安装到“应用程序”文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 來自 App Store，需要 Apple ID，而沙箱中沒有。請改從開發者網站下載，並安裝到「應用程式」資料夾。"
          }
        }
      }
    },
    "%@ covers sites of many owners. Enter a name under it, for example *.example.com.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ umfasst Websites vieler Eigentümer. Geben Sie darunter einen Namen ein, zum Beispiel *.example.com."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ covers sites of many owners. Enter a name under it, for example *.example.com."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ abarca sitios de muchos propietarios. Escribe un nombre debajo, por ejemplo *.example.com."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ couvre les sites de nombreux propriétaires. Saisissez un nom dessous, par exemple *.example.com."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ riguarda siti di molti proprietari. Inserisci un nome al suo interno, ad esempio *.example.com."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は多くの所有者のサイトにまたがります。その下の名前を入力してください。例：*.example.com"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 여러 소유자의 사이트를 포함합니다. 그 아래에 이름을 입력하세요. 예: *.example.com."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ abrange sites de vários proprietários. Digite um nome abaixo dele, por exemplo *.example.com."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ охватывает сайты многих владельцев. Укажите имя в этом домене, например *.example.com."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 涵盖许多不同所有者的网站。请输入它下面的名称，例如 *.example.com。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 涵蓋許多不同擁有者的網站。請輸入它之下的名稱，例如 *.example.com。"
          }
        }
      }
    },

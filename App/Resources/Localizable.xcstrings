    "Paused. Resume continues where it stopped.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiert. „Fortsetzen“ macht dort weiter, wo es angehalten hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused. Resume continues where it stopped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa. Reanudar continúa donde se detuvo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En pause. Reprendre continue là où le processus s’est arrêté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In pausa. Riprendi continua da dove si era fermato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時停止中です。「再開」をクリックすると、止まったところから続きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일시 중지됨. 재개하면 멈춘 지점부터 이어집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausado. Retomar continua de onde parou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приостановлено. «Продолжить» возобновит с того места, где остановилось."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已暂停。点按“恢复”可从停下的地方继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已暫停。按一下「繼續」可從停下的地方繼續。"
          }
        }
      }
    },

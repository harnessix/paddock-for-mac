    "The connection dropped. Check your network, then try again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung wurde unterbrochen. Prüfen Sie Ihr Netzwerk und versuchen Sie es dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection dropped. Check your network, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se perdió la conexión. Comprueba tu red y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion a été interrompue. Vérifiez votre réseau, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La connessione è caduta. Controlla la rete, poi riprova."

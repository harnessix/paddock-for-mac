            "state": "translated",
            "value": "在这里把本次会话的文件夹保留给以后的会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這裡把本次工作階段的資料夾保留給以後的工作階段。"
          }
        }
      }
    },
    "You set the clipboard of one session here.": {
      "extractionState": "manual",

    "Your file stays as it is. The agent's file stays in the copy.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Datei bleibt, wie sie ist. Die Datei des Agents bleibt in der Kopie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your file stays as it is. The agent's file stays in the copy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu archivo se queda como está. El archivo del agente se queda en la copia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre fichier reste tel quel. Le fichier de l’agent reste dans la copie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo file resta com'è. Il file dell'agente resta nella copia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのファイルはそのままです。エージェントのファイルはコピーに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자의 파일은 그대로 유지됩니다. 에이전트의 파일은 사본에 남습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu arquivo continua como está. O arquivo do agente fica na cópia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш файл остаётся как есть. Файл агента остаётся в копии."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的文件保持原样。智能体的文件留在副本中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的檔案保持原樣。智慧代理的檔案留在副本中。"
          }
        }
      }
    },

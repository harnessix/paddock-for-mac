    "The app asks again the next time it reaches these servers.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App fragt beim nächsten Zugriff auf diese Server erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app asks again the next time it reaches these servers."
          }
        },
        "es": {

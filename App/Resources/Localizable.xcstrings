    },
    "The app is not running. Choose Always, or start the app first.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App läuft nicht. Wählen Sie „Immer“ oder starten Sie zuerst die App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is not running. Choose Always, or start the app first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app no se está ejecutando. Elige Siempre o inicia primero la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app n’est pas en cours d’exécution. Choisissez Toujours, ou démarrez d’abord l’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",

    "An app that was not used for 90 days goes with its login and its files.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine App, die 90 Tage nicht verwendet wurde, wird samt Anmeldung und Dateien entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An app that was not used for 90 days goes with its login and its files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una app que no se usó en 90 días se elimina con su inicio de sesión y sus archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une app qui n’a pas été utilisée pendant 90 jours disparaît avec sa connexion et ses fichiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'app non usata per 90 giorni viene rimossa insieme al suo accesso e ai suoi file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "90日間使われなかったアプリは、ログインやファイルとともに削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "90일 동안 사용하지 않은 앱은 로그인 및 파일과 함께 삭제됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um app que não foi usado por 90 dias é removido junto com o login e os arquivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение, которым не пользовались 90 дней, удаляется вместе с его учётной записью и файлами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "90 天没有使用的应用会连同登录和文件一起移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "90 天未使用的應用程式會連同其登入資訊和檔案一起移除。"
          }
        }
      }
    },

    "Something of yours goes with it. Read the details first.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas von Ihnen geht damit verloren. Lesen Sie zuerst die Details."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something of yours goes with it. Read the details first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo tuyo se va con ello. Lee antes los detalles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelque chose qui vous appartient part avec elle. Lisez d’abord les détails."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con questo se ne va anche qualcosa di tuo. Leggi prima i dettagli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのものも一緒に削除されます。先に詳細をお読みください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자의 항목 일부도 함께 삭제됩니다. 먼저 세부 사항을 읽어 보세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo seu vai junto. Leia os detalhes primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вместе с этим будет удалено что-то ваше. Сначала прочитайте подробности."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的一些内容会随它一起移除。请先阅读详细信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的一些內容會隨它一起移除。請先閱讀詳細資訊。"
          }
        }
      }
    },

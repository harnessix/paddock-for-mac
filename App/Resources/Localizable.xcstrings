          }
        }
      }
    },
    "The app gets a launcher in your Applications folder, so it also starts from the Dock and Launchpad.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App erhält ein Startsymbol in Ihrem Programme-Ordner und startet so auch über das Dock und das Launchpad."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app gets a launcher in your Applications folder, so it also starts from the Dock and Launchpad."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app recibe un lanzador en tu carpeta Aplicaciones, así que también se inicia desde el Dock y Launchpad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",

          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сборка остановилась до запечатывания базового образа. «Повторить» продолжит с того места, где она остановилась."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "构建在基础映像封装之前停止了。“重试”会从停止的地方继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建置在基礎映像檔封存之前停止了。「重試」會從停止的地方繼續。"
          }
        }
      }
    },
    "The bundle %@ is not found. Install the app again, or remove it from paddock.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Paket %@ wurde nicht gefunden. Installieren Sie die App erneut oder entfernen Sie sie aus paddock."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bundle %@ is not found. Install the app again, or remove it from paddock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encuentra el paquete %@. Instala la app de nuevo o quítala de paddock."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paquet %@ est introuvable. Réinstallez l’app ou supprimez-la de paddock."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il bundle %@ non è stato trovato. Installa di nuovo l'app oppure rimuovila da paddock."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バンドル%@が見つかりません。アプリをインストールし直すか、paddockから削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번들 %@을(를) 찾을 수 없습니다. 앱을 다시 설치하거나 paddock에서 제거하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pacote %@ não foi encontrado. Instale o app de novo ou remova-o do paddock."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакет %@ не найден. Установите приложение снова или удалите его из paddock."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到应用包 %@。请重新安装该应用，或将它从 paddock 中移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到應用程式套件 %@。請重新安裝該應用程式，或將它從 paddock 中移除。"
          }
        }
      }
    },

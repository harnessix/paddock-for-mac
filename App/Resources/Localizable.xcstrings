          "stringUnit": {
            "state": "translated",
            "value": "%@ necesita la imagen base. Créala una vez y %@ se añadirá cuando esté lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a besoin de l’image de base. Créez-la une fois ; %@ sera ajouté lorsqu’elle sera prête."
          }
        },
        "it": {
          "stringUnit": {

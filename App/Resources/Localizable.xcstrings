    "Remove the base image (%@)? Apps cannot start until you build it again. App data stays.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Basis-Image entfernen (%@)? Apps können erst wieder starten, wenn Sie es neu aufbauen. App-Daten bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove the base image (%@)? Apps cannot start until you build it again. App data stays."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quitar la imagen base (%@)? Las apps no pueden iniciarse hasta que la crees de nuevo. Los datos de las apps se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer l’image de base (%@) ? Les apps ne peuvent pas démarrer tant que vous ne l’avez pas recréée. Les données des apps sont conservées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovere l'immagine di base (%@)? Le app non possono avviarsi finché non la crei di nuovo. I dati delle app restano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベースイメージ(%@)を削除しますか?もう一度作成するまで、アプリは起動できません。アプリのデータは残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 이미지(%@)를 제거할까요? 다시 빌드하기 전에는 앱을 시작할 수 없습니다. 앱 데이터는 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover a imagem-base (%@)? Os apps não podem iniciar até você criá-la de novo. Os dados dos apps permanecem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить базовый образ (%@)? Приложения не запустятся, пока вы не соберёте его заново. Данные приложений сохранятся."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要移除基础映像（%@）吗？重新构建之前，应用无法启动。应用数据会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要移除基礎映像檔（%@）嗎？重新建置之前，應用程式無法啟動。應用程式資料會保留。"
          }
        }
      }
    },

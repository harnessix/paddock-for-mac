    "This app came from the App Store and needs an Apple ID, which the sandbox does not have. Install the version from the maker's website instead.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App stammt aus dem App Store und benötigt eine Apple ID, die die Sandbox nicht hat. Installieren Sie stattdessen die Version von der Website des Herstellers."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app came from the App Store and needs an Apple ID, which the sandbox does not have. Install the version from the maker's website instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app viene de la App Store y necesita un Apple ID, que el entorno aislado no tiene. Instala en su lugar la versión del sitio web del desarrollador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette app provient de l’App Store et nécessite un identifiant Apple, que le bac à sable n’a pas. Installez plutôt la version du site de l’éditeur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quest'app proviene dall'App Store e richiede un Apple ID, che la sandbox non ha. Installa invece la versione dal sito web del produttore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリはApp Storeから入手したもので、サンドボックスにはないApple IDが必要です。代わりに、開発元のWebサイトのバージョンをインストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱은 App Store에서 받은 것으로, 샌드박스에 없는 Apple ID가 필요합니다. 대신 제작사 웹사이트의 버전을 설치하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este app veio da App Store e precisa de um Apple ID, que o sandbox não tem. Instale a versão do site do fabricante."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это приложение загружено из App Store и требует Apple ID, которого нет в песочнице. Вместо этого установите версию с сайта разработчика."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此应用来自 App Store，需要 Apple ID，而沙盒里没有。请改为安装开发者网站上的版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此應用程式來自 App Store，需要 Apple ID，而沙箱中沒有。請改為安裝開發者網站上的版本。"
          }
        }
      }
    },
    "This app can start when the base image is built. You build it once, for all apps.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App kann starten, sobald das Basis-Image aufgebaut ist. Sie bauen es einmal für alle Apps auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app can start when the base image is built. You build it once, for all apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app puede iniciarse cuando la imagen base esté creada. La creas una sola vez, para todas las apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette app pourra démarrer quand l’image de base sera créée. Vous la créez une seule fois, pour toutes les apps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quest'app può avviarsi quando l'immagine di base è creata. La crei una sola volta, per tutte le app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベースイメージを作成すると、このアプリを起動できます。ベースイメージは、すべてのアプリ用に一度だけ作成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 이미지가 빌드되면 이 앱을 시작할 수 있습니다. 기본 이미지는 모든 앱을 위해 한 번만 빌드합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este app pode iniciar quando a imagem-base for criada. Você a cria uma vez, para todos os apps."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это приложение сможет запуститься, когда базовый образ будет собран. Он собирается один раз для всех приложений."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "构建基础映像后，此应用就可以启动。基础映像只需构建一次，供所有应用使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建置基礎映像檔後，此應用程式就可以啟動。基礎映像檔只需建置一次，供所有應用程式使用。"
          }
        }
      }
    },

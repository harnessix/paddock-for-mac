    "In a git project, the agent can work on a copy. You decide what goes back.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In einem Git-Projekt kann der Agent an einer Kopie arbeiten. Sie entscheiden, was zurückgeht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In a git project, the agent can work on a copy. You decide what goes back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En un proyecto de git, el agente puede trabajar en una copia. Tú decides qué vuelve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans un projet git, l’agent peut travailler sur une copie. Vous décidez de ce qui revient."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In un progetto git, l'agente può lavorare su una copia. Sei tu a decidere cosa torna indietro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "gitプロジェクトでは、エージェントはコピー上で作業できます。何を元に戻すかはあなたが決めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "git 프로젝트에서는 에이전트가 사본에서 작업할 수 있습니다. 무엇을 되돌릴지는 사용자가 정합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em um projeto git, o agente pode trabalhar em uma cópia. Você decide o que volta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В проекте git агент может работать с копией. Что вернуть обратно, решаете вы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 git 项目中，智能体可以在副本上工作，哪些改动写回由你决定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 git 專案中，智慧代理可以在副本上工作，哪些更改寫回由你決定。"
          }
        }
      }
    },

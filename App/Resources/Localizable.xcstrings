          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение может прочитать то, что вы копируете на этом Mac, когда вы вставляете в нём."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在应用中粘贴时，应用可以读取你在这台 Mac 上拷贝的内容。"
          }

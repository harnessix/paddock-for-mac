          "stringUnit": {
            "state": "translated",
            "value": "Ancora niente di archiviato. Il primo avvio prepara l'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ何も保存されていません。最初の起動でアプリが準備されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 저장된 항목이 없습니다. 처음 시작할 때 앱이 준비됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",

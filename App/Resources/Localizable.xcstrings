    "Choose a folder on an APFS volume. paddock copies the base image for each app, which needs APFS.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie einen Ordner auf einem APFS-Volume. paddock kopiert das Basis-Image für jede App, was APFS erfordert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a folder on an APFS volume. paddock copies the base image for each app, which needs APFS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una carpeta en un volumen APFS. paddock copia la imagen base para cada app, y eso requiere APFS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un dossier sur un volume APFS. paddock copie l’image de base pour chaque app, ce qui nécessite APFS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una cartella su un volume APFS. paddock copia l'immagine di base per ogni app e per farlo serve APFS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APFSボリューム上のフォルダを選択してください。paddockはアプリごとにベースイメージをコピーするため、APFSが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "APFS 볼륨의 폴더를 선택하세요. paddock은 앱마다 기본 이미지를 복사하며, 이를 위해 APFS가 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma pasta em um volume APFS. O paddock copia a imagem-base para cada app, o que exige APFS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите папку на томе APFS. paddock копирует базовый образ для каждого приложения, а для этого нужен APFS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选取 APFS 宗卷上的文件夹。paddock 要为每个应用拷贝基础映像，这需要 APFS。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇 APFS 磁碟區上的資料夾。paddock 要為每個應用程式拷貝基礎映像檔，這需要 APFS。"
          }
        }
      }
    },
    "Choose a folder on this Mac. paddock cannot keep the base image on a network volume.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie einen Ordner auf diesem Mac. paddock kann das Basis-Image nicht auf einem Netzwerk-Volume ablegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a folder on this Mac. paddock cannot keep the base image on a network volume."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una carpeta en este Mac. paddock no puede guardar la imagen base en un volumen de red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un dossier sur ce Mac. paddock ne peut pas conserver l’image de base sur un volume réseau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una cartella su questo Mac. paddock non può conservare l'immagine di base su un volume di rete."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMac上のフォルダを選択してください。paddockはベースイメージをネットワークボリュームに置けません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac의 폴더를 선택하세요. paddock은 네트워크 볼륨에 기본 이미지를 보관할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma pasta neste Mac. O paddock não pode manter a imagem-base em um volume de rede."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите папку на этом Mac. paddock не может хранить базовый образ на сетевом томе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选取这台 Mac 上的文件夹。paddock 不能把基础映像存放在网络宗卷上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇這台 Mac 上的資料夾。paddock 無法把基礎映像檔存放在網路磁碟區上。"
          }
        }
      }
    },

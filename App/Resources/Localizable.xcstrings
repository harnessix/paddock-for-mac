        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app redemande la prochaine fois qu’elle joint ces serveurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app chiede di nuovo la prossima volta che raggiunge questi server."
          }
        },
        "ja": {

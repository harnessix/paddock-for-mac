    "%@ added. It also appears in Launchpad as \"%@\".": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde hinzugefügt. Die App erscheint auch im Launchpad als „%@“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ added. It also appears in Launchpad as \"%@\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha añadido %@. También aparece en Launchpad como «%@»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ajouté. Il apparaît aussi dans Launchpad sous le nom « %@ »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è stata aggiunta. Appare anche in Launchpad come \"%@\"."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を追加しました。Launchpadにも「%@」として表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 추가되었습니다. Launchpad에도 “%@”(으)로 나타납니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ adicionado. Ele também aparece no Launchpad como “%@”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ добавлено. Оно также есть в Launchpad как «%@»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已添加 %@。它也会以“%@”出现在“启动台”中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已加入 %@。它也會以「%@」顯示在 Launchpad 中。"
          }
        }
      }
    },

          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для ваших приложений Mac тоже можно создать комнаты. Это можно сделать позже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",

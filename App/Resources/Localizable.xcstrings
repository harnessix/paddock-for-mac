    "The copy changed since you looked. Check the list, then apply again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kopie hat sich geändert, seit Sie nachgesehen haben. Prüfen Sie die Liste und wenden Sie dann erneut an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",

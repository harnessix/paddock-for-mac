    "Stopping saves the app's state so it reopens in about 10 s. Its open questions are denied.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Stoppen wird der Zustand der App gesichert, sodass sie in etwa 10 Sek. wieder öffnet. Ihre offenen Fragen werden verweigert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopping saves the app's state so it reopens in about 10 s. Its open questions are denied."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al detenerla se guarda el estado de la app, para que se reabra en unos 10 s. Sus preguntas abiertas se deniegan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’arrêt enregistre l’état de l’app pour qu’elle se rouvre en environ 10 s. Ses questions ouvertes sont refusées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermandola, lo stato dell'app viene salvato e si riapre in circa 10 s. Le sue domande aperte vengono negate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "停止するとアプリの状態が保存され、約10秒で開き直せます。未回答の質問は拒否されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중지하면 앱의 상태가 저장되어 약 10초 안에 다시 열립니다. 열린 질문은 거부됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao parar, o estado do app é salvo para que ele reabra em cerca de 10 s. As perguntas abertas dele são negadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При остановке состояние приложения сохраняется, и оно снова откроется примерно за 10 с. Его открытые вопросы будут отклонены."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止时会保存应用的状态，下次约 10 秒即可重新打开。它未回答的询问会被拒绝。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止時會儲存應用程式的狀態，下次約 10 秒即可重新開啟。它未回答的詢問會被拒絕。"
          }
        }
      }
    },

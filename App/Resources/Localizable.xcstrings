    "%@ has %lld files open in %@. Removing the folder closes them for the app. Unsaved changes in those files can be lost.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ hat %lld Datei in %@ geöffnet. Beim Entfernen des Ordners wird sie für die App geschlossen. Nicht gesicherte Änderungen in dieser Datei können verloren gehen."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ hat %lld Dateien in %@ geöffnet. Beim Entfernen des Ordners werden sie für die App geschlossen. Nicht gesicherte Änderungen in diesen Dateien können verloren gehen."
                }
              }
            }
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has %lld files open in %@. Removing the folder closes them for the app. Unsaved changes in those files can be lost."
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ tiene %lld archivo abierto en %@. Al quitar la carpeta, la app lo cierra. Se pueden perder los cambios sin guardar de ese archivo."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ tiene %lld archivos abiertos en %@. Al quitar la carpeta, la app los cierra. Se pueden perder los cambios sin guardar de esos archivos."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ a %lld fichier ouvert dans %@. La suppression du dossier le ferme pour l’app. Les modifications non enregistrées dans ce fichier peuvent être perdues."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ a %lld fichiers ouverts dans %@. La suppression du dossier les ferme pour l’app. Les modifications non enregistrées dans ces fichiers peuvent être perdues."
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ ha %lld file aperto in %@. Rimuovere la cartella lo chiude per l'app. Le modifiche non salvate in quel file possono andare perse."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ ha %lld file aperti in %@. Rimuovere la cartella li chiude per l'app. Le modifiche non salvate in quei file possono andare perse."
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@は%3$@で%2$lld個のファイルを開いています。フォルダを削除すると、アプリはそれらのファイルを閉じます。これらのファイルの未保存の変更は失われる可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@이(가) %3$@에서 파일 %2$lld개를 열어 두고 있습니다. 폴더를 제거하면 앱에서 파일이 닫힙니다. 해당 파일에서 저장하지 않은 변경 사항은 사라질 수 있습니다."
          }
        },
        "pt-BR": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ tem %lld arquivo aberto em %@. Remover a pasta o fecha para o app. Alterações não salvas nele podem ser perdidas."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ tem %lld arquivos abertos em %@. Remover a pasta os fecha para o app. Alterações não salvas nesses arquivos podem ser perdidas."
                }
              }
            }
          }
        },
        "ru": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Открытых файлов у %1$@ в %3$@: %2$lld. Если удалить папку, приложение их закроет. Несохранённые изменения в этих файлах могут быть потеряны."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Открытых файлов у %1$@ в %3$@: %2$lld. Если удалить папку, приложение их закроет. Несохранённые изменения в этих файлах могут быть потеряны."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Открытых файлов у %1$@ в %3$@: %2$lld. Если удалить папку, приложение их закроет. Несохранённые изменения в этих файлах могут быть потеряны."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Открытых файлов у %1$@ в %3$@: %2$lld. Если удалить папку, приложение их закроет. Несохранённые изменения в этих файлах могут быть потеряны."
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在 %3$@ 中打开了 %2$lld 个文件。移除此文件夹会让应用关闭这些文件，其中未保存的更改可能会丢失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 在 %3$@ 中開啟了 %2$lld 個檔案。移除此資料夾會讓應用程式關閉這些檔案，其中未儲存的更改可能會遺失。"
          }
        }
      }
    },

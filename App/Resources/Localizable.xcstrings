    },
    "What you copy in the app reaches the clipboard of this Mac.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was Sie in der App kopieren, gelangt in die Zwischenablage dieses Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you copy in the app reaches the clipboard of this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que copias en la app llega al portapapeles de este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que vous copiez dans l’app arrive dans le presse-papiers de ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che copi nell'app arriva negli appunti di questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ内でコピーした内容は、このMacのクリップボードに入ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱에서 복사한 내용이 이 Mac의 클립보드로 전달됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você copia no app chega à área de transferência deste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "То, что вы копируете в приложении, попадает в буфер обмена этого Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在应用中拷贝的内容会进入这台 Mac 的剪贴板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你在應用程式中拷貝的內容會進入這台 Mac 的剪貼簿。"
          }
        }
      }
    },
    "When an app wants to reach a new server, the question appears here and next to the app's window.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn eine App einen neuen Server erreichen will, erscheint die Frage hier und neben dem Fenster der App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When an app wants to reach a new server, the question appears here and next to the app's window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando una app quiere acceder a un servidor nuevo, la pregunta aparece aquí y junto a la ventana de la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand une app veut joindre un nouveau serveur, la question apparaît ici et à côté de la fenêtre de l’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando un'app vuole raggiungere un nuovo server, la domanda compare qui e accanto alla finestra dell'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリが新しいサーバに接続しようとすると、質問がここと、アプリのウインドウの横に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 새 서버에 접근하려고 하면 질문이 여기와 앱 윈도우 옆에 나타납니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando um app quer acessar um novo servidor, a pergunta aparece aqui e ao lado da janela do app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда приложение хочет обратиться к новому серверу, вопрос появляется здесь и рядом с окном приложения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当应用想要连接新的服务器时，询问会显示在这里和应用窗口旁边。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當應用程式想要連線到新的伺服器時，詢問會顯示在這裡和應用程式視窗旁邊。"
          }
        }
      }
    },
    "When this is off, open paddock for Mac from the Applications folder to get the window and this setting back.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn dies ausgeschaltet ist, öffnen Sie paddock for Mac aus dem Programme-Ordner, um das Fenster und diese Einstellung zurückzuerhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When this is off, open paddock for Mac from the Applications folder to get the window and this setting back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si esto está desactivado, abre paddock for Mac desde la carpeta Aplicaciones para recuperar la ventana y este ajuste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand cette option est désactivée, ouvrez paddock for Mac depuis le dossier Applications pour retrouver la fenêtre et ce réglage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando è disattivata, apri paddock for Mac dalla cartella Applicazioni per riavere la finestra e questa impostazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにした場合は、「アプリケーション」フォルダからpaddock for Macを開くと、ウインドウとこの設定が戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 옵션이 꺼져 있으면 응용 프로그램 폴더에서 paddock for Mac을 열어 윈도우와 이 설정을 되찾으세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com isto desativado, abra o paddock for Mac pela pasta Aplicativos para recuperar a janela e este ajuste."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда это выключено, откройте paddock for Mac из папки «Программы», чтобы вернуть окно и эту настройку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后，请从“应用程序”文件夹打开 paddock for Mac，才能找回窗口和此设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉後，請從「應用程式」資料夾開啟 paddock for Mac，才能找回視窗和此設定。"
          }
        }
      }
    },
    "When this is off, quitting stops each app and saves its state.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn dies ausgeschaltet ist, stoppt das Beenden jede App und sichert ihren Zustand."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When this is off, quitting stops each app and saves its state."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si esto está desactivado, al salir se detiene cada app y se guarda su estado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand cette option est désactivée, quitter arrête chaque app et enregistre son état."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando è disattivata, uscendo si ferma ogni app e se ne salva lo stato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにすると、終了時に各アプリを停止し、その状態を保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 옵션이 꺼져 있으면 종료할 때 각 앱이 중지되고 상태가 저장됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com isto desativado, ao encerrar, cada app para e tem o estado salvo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда это выключено, при выходе каждое приложение останавливается, а его состояние сохраняется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后，退出时会停止每个应用并保存其状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉後，結束時會停止每個應用程式並儲存其狀態。"
          }
        }
      }
    },
    "When you answer a question about a server, the rule appears here. You can also add one yourself.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie eine Frage zu einem Server beantworten, erscheint hier die Regel. Sie können auch selbst eine hinzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you answer a question about a server, the rule appears here. You can also add one yourself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando respondes una pregunta sobre un servidor, la regla aparece aquí. También puedes añadir una tú mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous répondez à une question sur un serveur, la règle apparaît ici. Vous pouvez aussi en ajouter une vous-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando rispondi a una domanda su un server, la regola compare qui. Puoi anche aggiungerne una tu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバについての質問に答えると、ルールがここに表示されます。自分で追加することもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에 관한 질문에 응답하면 규칙이 여기에 나타납니다. 직접 추가할 수도 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você responde a uma pergunta sobre um servidor, a regra aparece aqui. Você também pode adicionar uma por conta própria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда вы отвечаете на вопрос о сервере, здесь появляется правило. Можно также добавить его самому."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当你回答关于某个服务器的询问后，规则会显示在这里。你也可以自己添加规则。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當你回答關於某個伺服器的詢問後，規則會顯示在這裡。你也可以自己加入規則。"
          }
        }
      }
    },

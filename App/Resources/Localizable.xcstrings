    "You can close this window; the build continues. Quitting paddock for Mac pauses it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können dieses Fenster schließen; der Aufbau wird fortgesetzt. Beenden Sie paddock for Mac, wird er pausiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can close this window; the build continues. Quitting paddock for Mac pauses it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cerrar esta ventana; la creación continúa. Al salir de paddock for Mac se pausa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez fermer cette fenêtre ; la création continue. Quitter paddock for Mac la met en pause."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi chiudere questa finestra; la creazione continua. Uscendo da paddock for Mac va in pausa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このウインドウは閉じても、作成は続きます。paddock for Macを終了すると一時停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 윈도우를 닫아도 빌드는 계속됩니다. paddock for Mac을 종료하면 일시 중지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode fechar esta janela; a criação continua. Encerrar o paddock for Mac a pausa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это окно можно закрыть; сборка продолжится. При выходе из paddock for Mac она приостанавливается."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以关闭此窗口，构建会继续进行。退出 paddock for Mac 会暂停构建。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以關閉此視窗，建置會繼續進行。結束 paddock for Mac 會暫停建置。"
          }
        }
      }
    },
    "You can pause the download, quit, and continue later.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können den Download pausieren, beenden und später fortsetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can pause the download, quit, and continue later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes pausar la descarga, salir y continuar más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez mettre le téléchargement en pause, quitter et continuer plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi mettere in pausa il download, uscire e continuare più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードは一時停止して終了し、後で続けられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드를 일시 중지하고 종료한 다음 나중에 이어서 할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode pausar o download, encerrar e continuar depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузку можно приостановить, выйти и продолжить позже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",

        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントはあなたに確認せずに作業します。サンドボックスにより、Macとプロジェクト外のファイルは安全です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 묻지 않고 작업합니다. 샌드박스가 Mac과 프로젝트 밖의 파일을 안전하게 보호합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O agente trabalha sem perguntar a você. O sandbox mantém seguros o seu Mac e os seus arquivos fora do projeto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агент работает без вопросов к вам. Песочница защищает ваш Mac и ваши файлы вне проекта."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体工作时不会询问你。沙盒保护你的 Mac 和项目之外的文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "智慧代理工作時不會詢問你。沙箱保護你的 Mac 和專案之外的檔案。"
          }
        }
      }
    },
    "The agent's file replaces yours. paddock backs yours up first.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei des Agents ersetzt Ihre. paddock sichert Ihre zuvor in einem Backup."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent's file replaces yours. paddock backs yours up first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo del agente reemplaza el tuyo. paddock hace antes una copia de seguridad del tuyo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier de l’agent remplace le vôtre. paddock sauvegarde d’abord le vôtre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file dell'agente sostituisce il tuo. paddock prima ne fa il backup."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントのファイルがあなたのファイルを置き換えます。paddockは先にあなたのファイルをバックアップします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트의 파일이 사용자의 파일을 대체합니다. paddock이 먼저 사용자의 파일을 백업합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo do agente substitui o seu. O paddock faz backup do seu antes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл агента заменяет ваш. Сначала paddock делает резервную копию вашего."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体的文件会替换你的文件。paddock 会先备份你的文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "智慧代理的檔案會取代你的檔案。paddock 會先備份你的檔案。"
          }
        }
      }
    },
    "The agent's version of these files is deleted from the copy. Your folder stays as it is.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Version dieser Dateien vom Agent wird aus der Kopie gelöscht. Ihr Ordner bleibt, wie er ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent's version of these files is deleted from the copy. Your folder stays as it is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión del agente de estos archivos se elimina de la copia. Tu carpeta se queda como está."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version de l’agent de ces fichiers est supprimée de la copie. Votre dossier reste tel quel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",

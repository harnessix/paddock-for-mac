    "macOS %@. paddock app mode needs macOS %@ or newer: update macOS in System Settings.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS %@. Der App-Modus von paddock benötigt macOS %@ oder neuer: Aktualisieren Sie macOS in den Systemeinstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS %@. paddock app mode needs macOS %@ or newer: update macOS in System Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS %@. El modo app de paddock necesita macOS %@ o posterior: actualiza macOS en Ajustes del Sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS %@. Le mode app de paddock nécessite macOS %@ ou une version plus récente : mettez à jour macOS dans Réglages Système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS %@. La modalità app di paddock richiede macOS %@ o successivo: aggiorna macOS in Impostazioni di Sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS %1$@。paddockのアプリモードにはmacOS %2$@以降が必要です。「システム設定」でmacOSをアップデートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS %1$@. paddock 앱 모드에는 macOS %2$@ 이상이 필요합니다. 시스템 설정에서 macOS를 업데이트하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS %@. O modo de apps do paddock exige macOS %@ ou mais novo: atualize o macOS em Ajustes do Sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS %@. Режиму приложений paddock нужна macOS %@ или новее: обновите macOS в Системных настройках."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS %@。paddock 的应用模式需要 macOS %@ 或更高版本：请在“系统设置”中更新 macOS。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS %@。paddock 的應用程式模式需要 macOS %@ 或更新版本：請在「系統設定」中更新 macOS。"
          }
        }
      }
    },

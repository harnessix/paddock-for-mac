          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os agentes nos painéis de terminal do paddock for Mac param quando ele encerra. O trabalho deles nas pastas dos projetos permanece."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенты в панелях терминала paddock for Mac останавливаются при выходе. Их работа в папках проектов сохраняется."
          }

    "Kept until an app ran on the new base image. Clean Up removes it then.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleibt erhalten, bis eine App auf dem neuen Basis-Image lief. Dann entfernt „Aufräumen“ es."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kept until an app ran on the new base image. Clean Up removes it then."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conserva hasta que una app se ejecute con la nueva imagen base. Entonces Limpiar la elimina."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservée jusqu’à ce qu’une app s’exécute sur la nouvelle image de base. Nettoyer la supprime alors."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservata finché un'app non è stata eseguita sulla nuova immagine di base. Poi Pulisci la rimuove."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいベースイメージでアプリが実行されるまで保持されます。その後、「クリーンアップ」で削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 기본 이미지에서 앱이 실행될 때까지 유지됩니다. 그 후에 정리하면 제거됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantida até um app rodar na nova imagem-base. Então Limpar a remove."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранится, пока какое-либо приложение не запустится на новом базовом образе. Тогда «Очистить» его удалит."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留到有应用在新基础映像上运行过为止，之后“清理”会移除它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留到有應用程式在新基礎映像檔上執行過為止，之後「清理」會將它移除。"
          }
        }
      }
    },

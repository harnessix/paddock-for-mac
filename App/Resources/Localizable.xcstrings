          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie das Protokoll, um den Grund zu sehen. Nennt es einen fehlenden Teil, aktualisieren Sie paddock."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the log to see why. If the log names a missing part, update paddock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el registro para ver el motivo. Si el registro nombra una parte que falta, actualiza paddock."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez le journal pour en voir la raison. Si le journal indique un élément manquant, mettez à jour paddock."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri il registro per vedere il motivo. Se il registro indica un componente mancante, aggiorna paddock."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログを開いて理由を確認してください。不足している部品がログに記載されている場合は、paddockをアップデートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그를 열어 이유를 확인하세요. 로그에 없는 구성 요소가 나오면 paddock을 업데이트하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o registro para ver o motivo. Se o registro citar uma parte que falta, atualize o paddock."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте журнал, чтобы узнать причину. Если в журнале указан недостающий компонент, обновите paddock."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请打开日志查看原因。如果日志提到缺少某个组件，请更新 paddock。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請打開記錄查看原因。如果記錄提到缺少某個元件，請更新 paddock。"
          }
        }
      }
    },

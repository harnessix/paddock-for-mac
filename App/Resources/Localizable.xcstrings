        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用程式下次連線到這些伺服器時會再次詢問。"
          }
        }
      }
    },
    "The app can read what you copy on this Mac when you paste in it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App kann lesen, was Sie auf diesem Mac kopieren, wenn Sie darin einsetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app can read what you copy on this Mac when you paste in it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app puede leer lo que copias en este Mac cuando pegas en ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app peut lire ce que vous copiez sur ce Mac quand vous collez dedans."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app può leggere ciò che copi su questo Mac quando incolli al suo interno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ内でペーストすると、アプリはこのMacでコピーした内容を読み取れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",

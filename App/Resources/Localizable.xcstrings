    },
    "You stopped the guided step. Try Again continues where it stopped.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben den geführten Schritt gestoppt. „Erneut versuchen“ macht dort weiter, wo er gestoppt hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You stopped the guided step. Try Again continues where it stopped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detuviste el paso guiado. Reintentar continúa donde se detuvo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez arrêté l’étape guidée. Réessayer continue là où elle s’est arrêtée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai fermato il passaggio guidato. Riprova continua da dove si era fermato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ガイド付きのステップを停止しました。「再試行」をクリックすると、止まったところから続きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안내 단계를 중지했습니다. ‘다시 시도’를 클릭하면 멈춘 지점부터 이어집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você interrompeu a etapa guiada. Tentar de novo continua de onde parou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы остановили пошаговую настройку. «Повторить» продолжит с того места, где она остановилась."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你停止了引导步骤。“重试”会从停止的地方继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你停止了引導步驟。「重試」會從停止的地方繼續。"
          }
        }
      }
    },
    "Your Mac apps can get rooms too. You can add them later.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch Ihre Mac-Apps können Räume bekommen. Sie können sie später hinzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Mac apps can get rooms too. You can add them later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus apps de Mac también pueden tener salas. Puedes añadirlas más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos apps Mac peuvent aussi avoir des salles. Vous pourrez les ajouter plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche le tue app per Mac possono avere delle stanze. Puoi aggiungerle più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macアプリにもルームを用意できます。あとから追加することもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 앱도 룸을 가질 수 있습니다. 나중에 추가할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",

    },
    "%@ GiB free, %@ GiB needed. Free up %@ GiB on the disk of %@, then check again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ GiB frei, %@ GiB benötigt. Geben Sie %@ GiB auf dem Volume von %@ frei und prüfen Sie dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ GiB free, %@ GiB needed. Free up %@ GiB on the disk of %@, then check again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ GiB libres, %@ GiB necesarios. Libera %@ GiB en el disco de %@ y vuelve a comprobarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Gio disponibles, %@ Gio nécessaires. Libérez %@ Gio sur le disque de %@, puis vérifiez à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ GiB liberi, %@ GiB necessari. Libera %@ GiB sul disco di %@, poi controlla di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空き容量は%1$@ GiB、必要な容量は%2$@ GiBです。%4$@のディスクで%3$@ GiBを空けてから、もう一度確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@GiB 사용 가능, %2$@GiB 필요합니다. %4$@의 디스크에서 %3$@GiB를 비운 다음 다시 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ GiB livres, %@ GiB necessários. Libere %@ GiB no disco de %@ e verifique de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свободно %@ GiB, нужно %@ GiB. Освободите %@ GiB на диске «%@» и проверьте снова."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可用 %@ GiB，需要 %@ GiB。请在 %4$@ 所在的磁盘上腾出 %3$@ GiB，然后重新检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可用 %@ GiB，需要 %@ GiB。請在 %@ 所在的磁碟上騰出 %@ GiB，然後重新檢查。"
          }
        }
      }
    },

    "Your folder changed in these files after the agent started. Choose what goes into your folder.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Ordner hat sich in diesen Dateien geändert, nachdem der Agent gestartet wurde. Wählen Sie, was in Ihren Ordner geht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your folder changed in these files after the agent started. Choose what goes into your folder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu carpeta cambió en estos archivos después de que el agente empezara. Elige qué va a tu carpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre dossier a changé dans ces fichiers après le démarrage de l’agent. Choisissez ce qui va dans votre dossier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua cartella è cambiata in questi file dopo l'avvio dell'agente. Scegli cosa va nella tua cartella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントの開始後に、これらのファイルがフォルダでも変更されました。どちらをフォルダに反映するか選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 시작된 후 이 파일들이 폴더에서 변경되었습니다. 폴더에 반영할 내용을 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua pasta mudou nestes arquivos depois que o agente começou. Escolha o que vai para a sua pasta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша папка в этих файлах изменилась после запуска агента. Выберите, что попадёт в вашу папку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体开始工作后，你的文件夹中的这些文件也有改动。请选择哪个版本进入你的文件夹。"
